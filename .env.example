VITE_SUPABASE_URL=https://your-simulator-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-simulator-anon-key

# Physical NODE_01-NODE_03 use this Supabase project when configured.
VITE_HARDWARE_SUPABASE_URL=https://your-hardware-project.supabase.co
VITE_HARDWARE_SUPABASE_ANON_KEY=your-hardware-anon-key
VITE_HARDWARE_SUPABASE_TABLE=capstone_dataset

# Legacy fallback for NODE_01 and NODE_02 when the hardware Supabase values above are empty.
VITE_HARDWARE_FIREBASE_URL=https://your-project-default-rtdb.firebaseio.com

VITE_API_BASE=http://localhost:8000/api/v1

# Verified in AgentRouter's live catalogue on 2026-09-17.
AGENTROUTER_API_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_API_KEY=

# Final no-API fallback after each remote provider exhausts 3 attempts.
LOCAL_LLM_FALLBACK_ENABLED=true
LOCAL_LLM_MODEL=google/flan-t5-small
LOCAL_LLM_DEVICE=cpu
# Keep true after downloading the model once so fallback never needs internet.
LOCAL_LLM_LOCAL_FILES_ONLY=true
LOCAL_LLM_MAX_INPUT_TOKENS=768
LOCAL_LLM_MAX_OUTPUT_TOKENS=256

# NODE_04-NODE_07 simulator GPS cluster inside FUT Minna, Gidan Kwano.
FUT_MINNA_CENTER_LATITUDE=9.53250
FUT_MINNA_CENTER_LONGITUDE=6.45250
FUT_MINNA_NODE_RADIUS_METERS=140
